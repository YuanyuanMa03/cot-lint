{
  "name": "cot-lint",
  "version": "0.2.1",
  "description": "Lint your repo for chain-of-thought leakage — the session-transcript residue AI assistants leave in docs, comments, and commit-adjacent prose. Ships the cot-trim skill as an installable DeepSeek Harness plugin.",
  "type": "module",
  "main": "./index.mjs",
  "exports": {
    ".": "./index.mjs",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "bin": {
    "cot-lint": "src/cli.js"
  },
  "files": [
    "src",
    "skills",
    "index.mjs",
    "cordis.patch.yml"
  ],
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "lint",
    "linter",
    "ai",
    "agents",
    "chain-of-thought",
    "prose",
    "documentation",
    "comments",
    "claude-code",
    "deepseek-harness",
    "dsh",
    "dsh-plugin"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YuanyuanMa03/cot-lint.git"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "test": "node test/smoke.mjs"
  }
}
